{
  "multipart": [
    {"when": {"tier": "1"}, "apply": {"model": "rustcraft:block/housing_core_1"}},
    {"when": {"tier": "2"}, "apply": {"model": "rustcraft:block/housing_core_2"}},
    {"when": {"tier": "3"}, "apply": {"model": "rustcraft:block/housing_core_3"}},
    {"when": {"tier": "4"}, "apply": {"model": "rustcraft:block/housing_core_4"}},
    {"when": {"north": "true", "tier": "1"}, "apply": {"model": "rustcraft:block/housing_arm_north_1"}},
    {"when": {"north": "true", "tier": "2"}, "apply": {"model": "rustcraft:block/housing_arm_north_2"}},
    {"when": {"north": "true", "tier": "3"}, "apply": {"model": "rustcraft:block/housing_arm_north_3"}},
    {"when": {"north": "true", "tier": "4"}, "apply": {"model": "rustcraft:block/housing_arm_north_4"}},
    {"when": {"east": "true", "tier": "1"}, "apply": {"model": "rustcraft:block/housing_arm_east_1"}},
    {"when": {"east": "true", "tier": "2"}, "apply": {"model": "rustcraft:block/housing_arm_east_2"}},
    {"when": {"east": "true", "tier": "3"}, "apply": {"model": "rustcraft:block/housing_arm_east_3"}},
    {"when": {"east": "true", "tier": "4"}, "apply": {"model": "rustcraft:block/housing_arm_east_4"}},
    {"when": {"south": "true", "tier": "1"}, "apply": {"model": "rustcraft:block/housing_arm_south_1"}},
    {"when": {"south": "true", "tier": "2"}, "apply": {"model": "rustcraft:block/housing_arm_south_2"}},
    {"when": {"south": "true", "tier": "3"}, "apply": {"model": "rustcraft:block/housing_arm_south_3"}},
    {"when": {"south": "true", "tier": "4"}, "apply": {"model": "rustcraft:block/housing_arm_south_4"}},
    {"when": {"west": "true", "tier": "1"}, "apply": {"model": "rustcraft:block/housing_arm_west_1"}},
    {"when": {"west": "true", "tier": "2"}, "apply": {"model": "rustcraft:block/housing_arm_west_2"}},
    {"when": {"west": "true", "tier": "3"}, "apply": {"model": "rustcraft:block/housing_arm_west_3"}},
    {"when": {"west": "true", "tier": "4"}, "apply": {"model": "rustcraft:block/housing_arm_west_4"}},
    {"when": {"up": "true", "tier": "1"}, "apply": {"model": "rustcraft:block/housing_arm_up_1"}},
    {"when": {"up": "true", "tier": "2"}, "apply": {"model": "rustcraft:block/housing_arm_up_2"}},
    {"when": {"up": "true", "tier": "3"}, "apply": {"model": "rustcraft:block/housing_arm_up_3"}},
    {"when": {"up": "true", "tier": "4"}, "apply": {"model": "rustcraft:block/housing_arm_up_4"}},
    {"when": {"down": "true", "tier": "1"}, "apply": {"model": "rustcraft:block/housing_arm_down_1"}},
    {"when": {"down": "true", "tier": "2"}, "apply": {"model": "rustcraft:block/housing_arm_down_2"}},
    {"when": {"down": "true", "tier": "3"}, "apply": {"model": "rustcraft:block/housing_arm_down_3"}},
    {"when": {"down": "true", "tier": "4"}, "apply": {"model": "rustcraft:block/housing_arm_down_4"}},
    {"when": {"OR": [{"east": "true"}, {"west": "true"}, {"north": "false", "south": "false", "up": "false", "down": "false"}]}, "apply": {"model": "rustcraft:block/housing_channels_x"}},
    {"when": {"OR": [{"north": "true"}, {"south": "true"}]}, "apply": {"model": "rustcraft:block/housing_channels_z"}},
    {"when": {"OR": [{"up": "true"}, {"down": "true"}]}, "apply": {"model": "rustcraft:block/housing_channels_y"}}
  ]
}
