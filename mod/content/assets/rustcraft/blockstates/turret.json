{
  "multipart": [
    {"when": {"facing": "north"}, "apply": {"model": "rustcraft:block/turret"}},
    {"when": {"facing": "east"}, "apply": {"model": "rustcraft:block/turret", "y": 90}},
    {"when": {"facing": "south"}, "apply": {"model": "rustcraft:block/turret", "y": 180}},
    {"when": {"facing": "west"}, "apply": {"model": "rustcraft:block/turret", "y": 270}},
    {"when": {"north": "true"}, "apply": {"model": "rustcraft:block/turret__link_north"}},
    {"when": {"east": "true"}, "apply": {"model": "rustcraft:block/turret__link_east"}},
    {"when": {"south": "true"}, "apply": {"model": "rustcraft:block/turret__link_south"}},
    {"when": {"west": "true"}, "apply": {"model": "rustcraft:block/turret__link_west"}},
    {"when": {"up": "true"}, "apply": {"model": "rustcraft:block/turret__link_up"}}
  ]
}
